# ==== Основное ====
ENVIRONMENT=production            # development | staging | production
APP_NAME=LOKAL Cloud Service
APP_VERSION=2.0.0
DEBUG=false

# ==== Сервер ====
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# ==== Безопасность (JWT) ====
# Сгенерируйте свой ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==== База данных (TinyDB) ====
DATABASE_PATH=db/users.json

# ==== Яндекс OAuth / Smart Home ====
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=https://your-domain/auth/callback

# ==== CORS (в продакшне укажите конкретные домены) ====
# ALLOWED_ORIGINS=["https://your-domain"]

# ==== Логирование ====
LOG_LEVEL=INFO
LOG_FILE=logs/lokal.log

# ==== Email (опционально, для будущих уведомлений) ====
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
